# Copia a .env (desarrollo local) y completa. No subir .env a Git.
SESSION_SECRET="cadena-aleatoria-de-64-caracteres-hex"
ADMIN_EMAIL="admin@haptica.co"
ADMIN_NAME="Administrador"
ADMIN_PASSWORD="cambiar-antes-del-primer-despliegue"   # minimo 12 caracteres (solo para seed/bootstrap)

# Desarrollo y pruebas: emulador de Firestore (npm run emulator). En produccion NO se define.
FIRESTORE_EMULATOR_HOST="127.0.0.1:8085"
GCLOUD_PROJECT="haptica-commission-manager"

# Ingreso con Google (opcional en desarrollo). Valores publicos de la app web de Firebase.
# NEXT_PUBLIC_FIREBASE_API_KEY="..."
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="haptica-commission-manager.firebaseapp.com"
# NEXT_PUBLIC_FIREBASE_PROJECT_ID="haptica-commission-manager"
# BOOTSTRAP_ADMIN_EMAIL="tu@correo"   # se crea como administrador la primera vez que entra con Google
