rules_version = '2';

// Háptica Commission Manager: NINGÚN cliente (navegador, app móvil) accede a Firestore.
// Toda lectura y escritura pasa por el servidor con el SDK Admin, que no se rige por estas reglas.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
