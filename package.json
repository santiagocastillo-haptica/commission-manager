    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.5",
    "exceljs": "^4.4.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
